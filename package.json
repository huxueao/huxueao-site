{
  "name": "huxueao-janus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch dev/server.mjs",
    "dev:cloudflare": "npm run build:pages && wrangler pages dev dist",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node scripts/janus-browser-check.mjs",
    "deploy:preview": "npm run build:pages && wrangler pages deploy dist --project-name huxueao-site --branch codex/janus-redesign",
    "deploy:production": "npm run build:pages && wrangler pages deploy dist --project-name huxueao-site --branch main",
    "build:pages": "node scripts/build-pages.mjs",
    "db:local": "wrangler d1 migrations apply oblique --local",
    "db:remote": "wrangler d1 migrations apply oblique --remote",
    "test:flight-browser": "node scripts/flight-browser-check.mjs",
    "data:flight": "node scripts/refresh-flight-snapshot.mjs"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "@playwright/test": "^1.56.0",
    "esbuild": "^0.25.0"
  }
}

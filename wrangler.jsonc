{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huxueao-site",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-21",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "oblique",
    "database_id": "697f70e7-975f-408e-becd-b818692739ba",
    "migrations_dir": "migrations"
  }],
  "vars": { "SITE_URL": "https://huxueao.com", "SITE_NAME": "OBLIQUE", "NODE_VERSION": "24" },
  "env": {
    "preview": {
      "d1_databases": [{
        "binding": "DB",
        "database_name": "oblique-preview",
        "database_id": "ad1bec8f-eddd-43f9-a099-8db8c3ceee0a",
        "migrations_dir": "migrations"
      }],
      "vars": {
        "SITE_URL": "https://codex-oblique-rebuild.huxueao-site.pages.dev",
        "SITE_NAME": "OBLIQUE",
        "NODE_VERSION": "24"
      }
    }
  }
}
